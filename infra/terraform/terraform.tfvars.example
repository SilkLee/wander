# Terraform variable overrides (safe defaults — customize before applying)
# Copy this file to terraform.tfvars and adjust as needed

region             = "ap-southeast-1"
cluster_name       = "workflowai"
node_instance_type = "t3.large"
node_min_size      = 2
node_max_size      = 4
node_desired_size  = 2
kubernetes_version = "1.29"
github_org         = "SilkLee"
github_repo        = "workflow-ai"
